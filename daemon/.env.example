# ─────────────────────────────────────────────────────────────────────────────
# Emu Memory Daemon — environment configuration
#
# This file is the single source of truth for every env var the daemon reads.
# Copy to `daemon/.env` and edit. When running inside the emulation-agent repo,
# the daemon will fall back to `backend/.env` if `daemon/.env` is missing.
#
# All variables are optional unless marked REQUIRED.
# ─────────────────────────────────────────────────────────────────────────────

# ── Workspace root ───────────────────────────────────────────────────────────
# Absolute path to the .emu/ directory the daemon manages. Defaults to
# <repo>/.emu when running from the source tree, or $HOME/.emu in production.
# Set this when running the daemon outside of the emulation-agent repo.
#EMU_ROOT=

# ── Provider selection ───────────────────────────────────────────────────────
# Which LLM provider the daemon's agent loop should use. Independent of the
# foreground app's EMU_PROVIDER so you can run a cheaper model in the daemon.
# Supported: claude | openai | openrouter | fireworks | together_ai
#            | openai_compatible | baseten | ollama
# Not supported (yet): bedrock, gemini, h_company, modal
EMU_DAEMON_PROVIDER=openrouter

# Optional model override. Required for openai_compatible / baseten.
# Ignored when EMU_DAEMON_PROVIDER=claude (uses claude-sonnet-4-6 by default).
EMU_DAEMON_MODEL=openai/gpt-5.4

# API key for the daemon's provider.
# Resolution order:
#   1. EMU_DAEMON_API_KEY (this var)
#   2. macOS Keychain entry for service `com.emu.memory-daemon`
#   3. The provider's own key env var (ANTHROPIC_API_KEY, OPENAI_API_KEY,
#      OPENROUTER_API_KEY, FIREWORKS_API_KEY, TOGETHER_API_KEY,
#      BASETEN_API_KEY, OLLAMA_API_KEY)
EMU_DAEMON_API_KEY=

# ── Tick cadence ─────────────────────────────────────────────────────────────
# Seconds between launchd-triggered ticks. The plist template uses 120s by
# default; this var only matters when running daemon.run in a loop yourself.
EMU_DAEMON_INTERVAL_SECONDS=300

# ── OpenAI-compatible / self-hosted endpoints (only when used) ───────────────
# Required when EMU_DAEMON_PROVIDER=openai_compatible.
#OPENAI_BASE_URL=
#OPENAI_MODEL=

# Required when EMU_DAEMON_PROVIDER=baseten.
#BASETEN_API_URL=
#BASETEN_MODEL=

# Optional Ollama overrides (defaults: http://localhost:11434/v1, qwen3.5:9b).
#OLLAMA_BASE_URL=
#OLLAMA_MODEL=

# ── Install behavior ─────────────────────────────────────────────────────────
# 1 (default) installs/refreshes the macOS launchd agent non-interactively
# when backend.sh starts. Set to 0 for the interactive y/N/never prompt.
EMU_DAEMON_AUTO_INSTALL=1
